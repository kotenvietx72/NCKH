@model IEnumerable<BaiToanGioTanHoc.Models.GiangVien>

@{
    ViewBag.Title = "Index";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MaGiangVien)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HoTenGiangVien)
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.MaGiangVien)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HoTenGiangVien)
                </td>
                <td>
                    @if (User.IsInRole("Administrator"))
                    {
                        @Html.ActionLink("Cập nhật", "Edit", new { id = item.MaGiangVien }) @Html.Raw(" | ")
                        @Html.ActionLink("Xóa", "Delete", new { id = item.MaGiangVien }) @Html.Raw(" | ")
                    }
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.MaGiangVien })
                </td>
            </tr>
        }

    </table>
</body>
</html>
