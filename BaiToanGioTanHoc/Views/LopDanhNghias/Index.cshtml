@model IEnumerable<BaiToanGioTanHoc.Models.LopDanhNghia>

@{
    ViewBag.Title = "Index";
}

<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.MaLopDN)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TenLopDN)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MaLopDN)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TenLopDN)
            </td>
            <td>
                @if (User.IsInRole("Administrator"))
                {
                    @Html.ActionLink("Cập nhật", "Edit", new { id = item.MaLopDN }) @Html.Raw(" | ")
                    @Html.ActionLink("Xóa", "Delete", new { id = item.MaLopDN }) @Html.Raw(" | ")
                }
                @Html.ActionLink("Chi tiết", "Details", new { id = item.MaLopDN })
            </td>
        </tr>
    }

</table>
