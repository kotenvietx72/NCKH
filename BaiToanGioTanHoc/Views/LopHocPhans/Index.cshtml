@model IEnumerable<BaiToanGioTanHoc.Models.LopHocPhan>

@{
    ViewBag.Title = "Index";
}
@using (Html.BeginForm("Index", "LopHocPhans", FormMethod.Get))
{
    <label>Nhập mã lớp học phần:</label>
    <input type="text" name="searchMaLHP" class="form-control" value="@Request.QueryString["searchMaLHP"]" placeholder="Nhập mã lớp học phần" />
    <button type="submit" class="btn btn-primary mt-2">Tìm kiếm</button>
}
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.MaLHP)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.SiSo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.GiangVien.HoTenGiangVien)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.LopDanhNghia.TenLopDN)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.MonHoc.TenMH)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MaLHP)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SiSo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GiangVien.HoTenGiangVien)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LopDanhNghia.TenLopDN)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MonHoc.TenMH)
            </td>
            <td>
                @if (User.IsInRole("Administrator"))
                {
                    @Html.ActionLink("Cập nhật", "Edit", new { id = item.MaLHP }) @Html.Raw(" | ")
                    @Html.ActionLink("Xóa", "Delete", new { id = item.MaLHP }) @Html.Raw(" | ")
                }
                @Html.ActionLink("Chi tiết", "Details", new { id = item.MaLHP })
            </td>
        </tr>
    }

</table>
